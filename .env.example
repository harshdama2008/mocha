# Copy this file to .env and fill in real (test-mode / sandbox) values.
# Never put real values in this file — only in .env, which must be gitignored.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (src/server/supabaseAdmin.ts) — bypasses RLS, never ship to the app bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: use TEST/SANDBOX keys only (pk_test_... / sk_test_...), never live keys.
STRIPE_SECRET_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
