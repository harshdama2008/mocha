#!/bin/sh
# Real git hook — enforced by git itself, not by Claude Code's permission
# layer. This is the actual hard gate: it fires no matter which tool,
# subagent, or terminal issued the push, and doesn't depend on Claude
# Code's own deny-rule/hook enforcement being bug-free.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks

z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue  # branch deletion, nothing to check

  if [ "$remote_sha" != "$z40" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "pre-push: this push would rewrite remote history. Blocked." >&2
      exit 1
    fi
  fi
done

echo "pre-push: running test suite..."
npm test
if [ $? -ne 0 ]; then
  echo "pre-push: tests failed. Push blocked." >&2
  exit 1
fi

exit 0
